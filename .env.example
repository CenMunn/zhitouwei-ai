# DeepSeek Flash runtime, 2026-10-18. Replace blank values locally; never publish your .env.
# Paths below are resolved from the source root by tools/source-control.cjs.
DATABASE_URL=file:./db/application.db
FILINGS_DATA_DIR=./db/filing-documents
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
APP_BIND_HOST=127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# All generation paths use the same DeepSeek Flash configuration.
FILINGS_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
FILINGS_RETRY_POLICY=no_content_only

